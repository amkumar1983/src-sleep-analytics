{
	"name": "sleep-analytics-pipeline",
	"properties": {
		"activities": [
			{
				"name": "Copy-raw-to-bronze",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"maxConcurrentConnections": 16,
							"recursive": true,
							"wildcardFolderPath": {
								"value": "@concat( 'source=ftp/sleep-data_',formatDateTime(pipeline().TriggerTime,'dd-MM-yyyy'))",
								"type": "Expression"
							},
							"wildcardFileName": "*.json",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"maxConcurrentConnections": 16,
							"copyBehavior": "PreserveHierarchy"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "sink_raw",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sink_bronze",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "copy-ftp-to-raw",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "FtpReadSettings",
							"maxConcurrentConnections": 16,
							"recursive": true,
							"wildcardFolderPath": "CPAP/sleep-data",
							"wildcardFileName": "*.json",
							"enablePartitionDiscovery": false,
							"useBinaryTransfer": true,
							"disableChunking": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"maxConcurrentConnections": 16,
							"copyBehavior": "PreserveHierarchy"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "source_dataset",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sink_raw",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Get Metadata1",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "copy-ftp-to-raw",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "sink_raw",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"lastModified"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "FileExists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get Metadata1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('Get Metadata1').output.exists",
						"type": "Expression"
					}
				}
			},
			{
				"name": "LogFailureNotebook",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "FileExists",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/riniviw113@fisedo.com/src-sleep-analytics/Notebooks/LogFailureNoteBook"
				},
				"linkedServiceName": {
					"referenceName": "lnk_ser_databricks",
					"type": "LinkedServiceReference"
				}
			}
		],
		"variables": {
			"runFolder": {
				"type": "String",
				"defaultValue": "@formatDateTime(pipeline().TriggerTime,'yyyyMMdd_HHmmss')"
			},
			"logContent": {
				"type": "String"
			},
			"year": {
				"type": "String"
			},
			"month": {
				"type": "String"
			},
			"day": {
				"type": "String"
			},
			"fileName": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-07-12T10:35:15Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}